# Public URL of the Next.js frontend
NEXT_PUBLIC_SITE_URL=https://test.bendemen.com

# WooCommerce REST API (WooCommerce stays the order/product backend)
WOOCOMMERCE_URL=https://www.bendemen.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me

# Optional Redis cache for public catalogue data only. Keep Redis private/firewalled.
# If omitted or unavailable, Next.js Data Cache is used instead.
# REDIS_URL=redis://127.0.0.1:6379

# Mollie API key: use a test key until the complete flow has been tested.
MOLLIE_API_KEY=test_replace_me
MOLLIE_WEBHOOK_URL=https://test.bendemen.com/api/mollie/webhook

# Server-to-server shared secret for the Bendemen WordPress account bridge (32+ random characters).
BENDEMEN_BRIDGE_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# HMAC signing secret for the frontend's httpOnly account session cookie (32+ random characters).
BENDEMEN_AUTH_SECRET=replace_with_another_long_random_secret_at_least_32_chars
