# Public WooCommerce Store API
WC_STORE_API_URL=https://www.bendemen.com/wp-json/wc/store/v1

# Optional comma-separated category slugs to exclude from the storefront.
HIDDEN_PRODUCT_CATEGORY_SLUGS=

# SMTP settings for the contact form (server-side only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=info@bendemen.nl

# Private WooCommerce REST API credentials (server-side only).
WC_API_URL=https://www.bendemen.com
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me

PORT=3000
WP_API_URL=https://www.bendemen.com/wp-json/wp/v2
