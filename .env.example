# Public URL of the Next.js frontend
NEXT_PUBLIC_SITE_URL=https://shop.bendemen.com

# WooCommerce REST API (WooCommerce stays the order/product backend)
WOOCOMMERCE_URL=https://www.bendemen.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me

# Shipping: configure one flat rate matching the active WooCommerce shipping zone.
# Replace the cost with the actual configured rate before accepting orders.
WOOCOMMERCE_SHIPPING_METHOD_ID=flat_rate
WOOCOMMERCE_SHIPPING_METHOD_TITLE=Standaard verzending
WOOCOMMERCE_SHIPPING_COST=REPLACE_ME

# Mollie API key: use a test key until the complete flow has been tested.
MOLLIE_API_KEY=test_replace_me
MOLLIE_WEBHOOK_URL=https://shop.bendemen.com/api/mollie/webhook
