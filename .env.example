# Public WooCommerce Store API (product catalog)
WC_STORE_API_URL=https://www.bendemen.com/wp-json/wc/store/v1

# Private WooCommerce REST API credentials.
# Only needed for server-side admin operations; never use NEXT_PUBLIC_.
WC_API_URL=https://www.bendemen.com
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me

# Pterodactyl normally injects SERVER_PORT automatically.
# For local runs, PORT defaults to 3000.
PORT=3000

# WordPress REST API used to mirror existing content pages
WP_API_URL=https://www.bendemen.com/wp-json/wp/v2
